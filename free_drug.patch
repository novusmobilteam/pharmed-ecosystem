+            }
+            return null;
+          },
+          dataSource: (skip, take, search) =>
+              context.read<GetServicesUseCase>().call(PagedQueryParams(skip: skip, take: take, searchQuery: search)),
+          onSelected: vm.updateIndependentServices,
         );
       },
     );
